# ===== Entorno local de la tienda =====
# Puerto del servidor
PORT=3000

# Credenciales semilla del administrador (solo se usan la 1ra vez al crear la BD)
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# Número de WhatsApp para las boletas (con código de país, sin +)
WHATSAPP_NUMBER=51999999999

# ===== Base de datos =====
# sqlite (por defecto, cero configuración) | mssql (SQL Server local)
DB_DRIVER=sqlite

# --- Solo si DB_DRIVER=mssql (instancia local sin Docker, o contenedor opcional) ---
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DB=tienda_db
MSSQL_USER=sa
MSSQL_PASSWORD=Tienda!Pass2026
